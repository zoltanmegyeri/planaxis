{
  "name": "@planaxis/validator",
  "version": "0.0.0",
  "private": true,
  "description": "PlanAxis Apartment SVG validator package",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@planaxis/geometry": "workspace:*",
    "@planaxis/parser": "workspace:*",
    "lossless-json": "4.3.1",
    "tzdata": "1.0.50"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
